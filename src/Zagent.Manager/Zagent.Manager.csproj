<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Zagent.Shared\Zagent.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\zagent-manager.ico" />
    <Resource Include="Assets\zagent-manager.png" />
    <Content Include="Assets\notification-kring.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\zagent-manager.ico</ApplicationIcon>
  </PropertyGroup>

</Project>