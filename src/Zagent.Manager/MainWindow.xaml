<Window x:Class="Zagent.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zagent Manager"
        Icon="Assets/zagent-manager.ico"
        Width="1480"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42"
                            Background="{StaticResource AccentSoft}"
                            CornerRadius="10"
                            Margin="0,0,12,0"
                            Padding="5">
                        <Image Source="Assets/zagent-manager.png"
                               Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Zagent Manager"
                                       FontSize="21"
                                       FontWeight="Bold"/>
                            <Border Background="{StaticResource AccentSoft}"
                                    CornerRadius="10"
                                    Margin="10,1,0,0"
                                    Padding="8,2">
                                <TextBlock Text="{Binding CoreVersion}"
                                           FontSize="12"
                                           Foreground="{StaticResource Accent}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Local Control for Zagent Services &#x00B7; Tunnel, Files, Web, ArcMap and Development Agents"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="&#x25B6;  Start All"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding StartAllCommand}"/>
                        <Button Content="&#x25A0;  Stop All"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding StopAllCommand}"/>
                        <Button Content="&#x21BB;  Restart All"
                                Command="{Binding RestartAllCommand}"/>
                        <Button Content="&#x2713;  Check All"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="520"
                               Margin="0,4,2,0"
                               ToolTip="{Binding StatusText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    TabStripPlacement="Left"
                    Background="{StaticResource SidebarBackground}">
            <TabItem Header="&#x2302;  Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource WindowBackground}">
                    <StackPanel Margin="18">
                        <UniformGrid Columns="4" Margin="0,0,0,12">
                            <Border Style="{StaticResource CardBorder}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Capabilities" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding CapabilityCount}"
                                               FontSize="27"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="Registered tools"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Running Processes" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding RunningProcesses}"
                                               FontSize="27"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="Core-owned services"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Active Tasks" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding ActiveTasks}"
                                               FontSize="27"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="Current routed work"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Pending Requests" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding PendingApprovals}"
                                               FontSize="27"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="Files / local approvals"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardBorder}" Margin="5,0,5,12" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Services Overview"
                                                   FontSize="16"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="Quick control of Zagent core agents and MCP endpoints"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource AccentSoft}"
                                            CornerRadius="10"
                                            Padding="9,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CapabilityCount, StringFormat=Tools: {0}}"
                                                   Foreground="{StaticResource Accent}"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding Agents}"
                                          SelectedItem="{Binding SelectedAgent}"
                                          MinHeight="260"
                                          BorderThickness="0,1,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Agent" Binding="{Binding Name}" Width="160"/>
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="135"/>
                                        <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="90"/>
                                        <DataGridTextColumn Header="Process" Binding="{Binding ProcessState}" Width="90"/>
                                        <DataGridTextColumn Header="PID" Binding="{Binding OsProcessId}" Width="70"/>
                                        <DataGridTextColumn Header="Tools" Binding="{Binding CapabilityCount}" Width="65"/>
                                        <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="225"/>
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                                        <DataGridTemplateColumn Header="Actions" Width="280">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Start"
                                                                Padding="9,4"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Command="{Binding DataContext.StartAgentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding AgentId}"/>
                                                        <Button Content="Stop"
                                                                Padding="9,4"
                                                                Command="{Binding DataContext.StopAgentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding AgentId}"/>
                                                        <Button Content="Restart"
                                                                Padding="9,4"
                                                                Command="{Binding DataContext.RestartAgentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding AgentId}"/>
                                                        <Button Content="Check"
                                                                Padding="9,4"
                                                                Command="{Binding DataContext.RefreshAgentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding AgentId}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="5,0,5,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Live Visual Viewer"
                                                   FontSize="16"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding VisualStatus}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource AccentSoft}"
                                            CornerRadius="10"
                                            Padding="9,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="observe → reason → act → observe"
                                                   Foreground="{StaticResource Accent}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                <Border BorderBrush="{StaticResource PanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Background="White"
                                        MinHeight="180"
                                        MaxHeight="420"
                                        Padding="6">
                                    <Image Source="{Binding VisualLatestPath}"
                                           Stretch="Uniform"
                                           MaxHeight="400"/>
                                </Border>
                                <TextBlock Text="{Binding VisualMetadata}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="5,0,5,5" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="96"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="16,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Pending Requests"
                                                   FontSize="16"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="Local approval requests from Zagent Files. Web pairing stays in Chrome Bridge."
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Deny"
                                                Style="{StaticResource DangerButton}"
                                                Command="{Binding DenyCommand}"
                                                IsEnabled="{Binding SelectedApproval.CanResolveLocally}"/>
                                        <Button Content="Approve"
                                                Style="{StaticResource SuccessButton}"
                                                Command="{Binding ApproveCommand}"
                                                IsEnabled="{Binding SelectedApproval.CanResolveLocally}"/>
                                    </StackPanel>
                                </Grid>
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding Approvals}"
                                          SelectedItem="{Binding SelectedApproval}"
                                          BorderThickness="0,1,0,0"
                                          RowHeight="32"
                                          ColumnHeaderHeight="32"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="115"/>
                                        <DataGridTextColumn Header="Request ID" Binding="{Binding RequestId}" Width="190"/>
                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130"/>
                                        <DataGridTextColumn Header="Requested By" Binding="{Binding RequestedBy}" Width="120"/>
                                        <DataGridCheckBoxColumn Header="Privilege" Binding="{Binding PrivilegeEscalation}" Width="80"/>
                                        <DataGridTextColumn Header="Request" Binding="{Binding Summary}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="5,12,5,5" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="190"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#x25A4;"
                                                   Foreground="{StaticResource Accent}"
                                                   FontSize="16"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Log Chat &amp; Agent Logs"
                                                   FontSize="16"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Clear"
                                                Padding="10,5"
                                                Command="{Binding ClearDashboardChatCommand}"/>
                                        <CheckBox Content="Auto-scroll"
                                                  IsChecked="{Binding AutoScrollChat}"
                                                  Margin="8,0"/>
                                        <ComboBox Width="110"
                                                  Height="30"
                                                  ItemsSource="{Binding DashboardLogFilters}"
                                                  SelectedItem="{Binding DashboardLogFilter}"
                                                  VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="DashboardChatList"
                                         Grid.Row="1"
                                         ItemsSource="{Binding DashboardChatEntries}"
                                         Background="#FCFCFF"
                                         BorderBrush="{StaticResource AccentBorder}"
                                         BorderThickness="1"
                                         Margin="12,0,12,12"
                                         Padding="4"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x2022;"
                                                               Foreground="{StaticResource Accent}"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Source, StringFormat= [{0}]}"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               Margin="6,0,0,0"/>
                                                    <TextBlock Text="{Binding Timestamp, Converter={StaticResource UnixTimeConverter}}"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               FontSize="11"
                                                               Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}"
                                                           TextWrapping="Wrap"
                                                           Margin="14,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="&#x25C7;  Capabilities">
                <Grid Margin="20" Background="{StaticResource WindowBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CapabilitySearch, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="360"
                                     ToolTip="Cari capability, agent, access, atau approval"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CapabilityCount, StringFormat={}{0} registered}"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Capabilities}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Capability" Binding="{Binding Capability}" Width="260"/>
                            <DataGridTextColumn Header="Agent" Binding="{Binding AgentName}" Width="155"/>
                            <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="90"/>
                            <DataGridTextColumn Header="Execution" Binding="{Binding Execution}" Width="100"/>
                            <DataGridTextColumn Header="Approval" Binding="{Binding Approval}" Width="90"/>
                            <DataGridTextColumn Header="Resource" Binding="{Binding ResourcePolicy}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Cancel" Binding="{Binding SupportsCancel}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Progress" Binding="{Binding SupportsProgress}" Width="75"/>
                            <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="90"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding AgentVersion}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="&#x25A6;  ArcMap Workflow">
                <Grid Margin="20" Background="{StaticResource WindowBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ArcMap Orchestrator Runs"
                                           FontSize="16"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Durable run state, session isolation, blockers, evidence, and publication status. ETA is not shown unless backed by measured history."
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,12,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Load Evidence"
                                    Command="{Binding LoadArcMapWorkflowEvidenceCommand}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ArcMapWorkflows}"
                              SelectedItem="{Binding SelectedArcMapWorkflow}"
                              Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Run" Binding="{Binding RunId}" Width="190"/>
                            <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="180"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="130"/>
                            <DataGridTextColumn Header="Strategy" Binding="{Binding Strategy}" Width="160"/>
                            <DataGridTextColumn Header="Task" Binding="{Binding TaskId}" Width="160"/>
                            <DataGridTextColumn Header="Repairs" Binding="{Binding RepairCount}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Cancel" Binding="{Binding CancelRequested}" Width="70"/>
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt, Converter={StaticResource UnixTimeConverter}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ArcMapWorkflowEvidence}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="&#x25C9;  Monitoring">
                <Grid Margin="20" Background="{StaticResource WindowBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Show recent completed"
                                      IsChecked="{Binding ShowRecentCompleted}"/>
                            <TextBlock Text="Task terbaru berada di atas."
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="95"/>
                            <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="70"/>
                            <DataGridTextColumn Header="Stop Mode" Binding="{Binding StopMode}" Width="145"/>
                            <DataGridTextColumn Header="Agent" Binding="{Binding Agent}" Width="115"/>
                            <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="180"/>
                            <DataGridTextColumn Header="Chat" Binding="{Binding SessionId}" Width="155"/>
                            <DataGridTextColumn Header="Access" Binding="{Binding AccessMode}" Width="80"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="65"/>
                            <DataGridTextColumn Header="Resource" Binding="{Binding ResourceKey}" Width="180"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                            <DataGridTemplateColumn Header="Action" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="STOP"
                                                Style="{StaticResource DangerButton}"
                                                Padding="8,4"
                                                Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2"
                               Text="STOP membatalkan task melalui Tunnel journal. Work yang sudah selesai tidak di-rollback otomatis."
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="&#x25A4;  Log Chat">
                <Grid Margin="20" Background="{StaticResource WindowBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Log Chat"
                                           FontSize="19"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Progress messages sent during Zagent work. Hidden reasoning is never recorded."
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="{Binding ChatHistoryButtonText}"
                                        Command="{Binding ShowChatHistoryCommand}"
                                        Padding="10,5"
                                        Margin="0,0,6,0"/>
                                <Button Content="Clear View"
                                        Command="{Binding ClearChatViewCommand}"
                                        Padding="10,5"
                                        Margin="0,0,6,0"/>
                                <Button Content="Refresh"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding RefreshChatCommand}"
                                        Padding="10,5"
                                        Margin="0,0,10,0"/>
                                <CheckBox Content="Auto-scroll"
                                          IsChecked="{Binding AutoScrollChat}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding ChatColumns}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5"
                                        Style="{StaticResource CardBorder}"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource AccentSoft}"
                                                Padding="12"
                                                CornerRadius="11,11,0,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent}"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                        <ListBox Grid.Row="1"
                                                 ItemsSource="{Binding Entries}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="10,7,10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Source}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Accent}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Timestamp, Converter={StaticResource UnixTimeConverter}}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       Margin="10,0,0,0"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Message}"
                                                                   FontSize="12.5"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <TabItem Header="&#x2611;  Profiles &amp; Approvals">
                <Grid Margin="20" Background="{StaticResource WindowBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <GroupBox Header="Files Profiles">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="+ Add Path"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AddProfileCommand}"/>
                                <Button Content="Set Default"
                                        Command="{Binding SwitchProfileCommand}"
                                        Margin="8,0,0,0"/>
                                <Button Content="Edit / Update"
                                        Command="{Binding EditProfileCommand}"
                                        Margin="8,0,0,0"/>
                                <Button Content="Enable / Disable"
                                        Command="{Binding ToggleProfileEnabledCommand}"
                                        Margin="8,0,0,0"/>
                                <Button Content="− Remove Path"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding RemoveProfileCommand}"
                                        Margin="8,0,0,0"/>
                                <TextBlock Text="Default hanya dipakai oleh session baru. Session yang sudah aktif tidak berpindah root otomatis."
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="10,6,0,0"
                                           TextWrapping="Wrap"/>
                            </WrapPanel>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="130"/>
                                    <DataGridTextColumn Header="Root" Binding="{Binding Root}" Width="*"/>
                                    <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="100"/>
                                    <DataGridCheckBoxColumn Header="Default" Binding="{Binding Active}" Width="70"/>
                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="70"/>
                                    <DataGridTextColumn Header="Authorization" Binding="{Binding AuthorizationSource}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="2" Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Active Files Sessions"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Pilih session dan profile di tabel atas, lalu Set for Session untuk mengganti root session itu saja."
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Set for Session"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SwitchSessionProfileCommand}"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            <DataGrid Grid.Row="3"
                                      ItemsSource="{Binding FilesSessions}"
                                      SelectedItem="{Binding SelectedFilesSession}"
                                      Margin="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Session ID" Binding="{Binding SessionId}" Width="*"/>
                                    <DataGridTextColumn Header="Active Profile" Binding="{Binding ActiveProfile}" Width="140"/>
                                    <DataGridTextColumn Header="Mounted Profiles" Binding="{Binding MountedProfiles}" Width="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Header="Pending Local Approvals / Plugin Access">
                        <DataGrid ItemsSource="{Binding Approvals}"
                                  SelectedItem="{Binding SelectedApproval}"
                                  Margin="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="130"/>
                                <DataGridTextColumn Header="Request ID" Binding="{Binding RequestId}" Width="165"/>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110"/>
                                <DataGridTextColumn Header="Operator / Requested By" Binding="{Binding RequestedBy}" Width="145"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/>
                                <DataGridTextColumn Header="Time" Binding="{Binding CreatedAt, Converter={StaticResource UnixTimeConverter}}" Width="115"/>
                                <DataGridCheckBoxColumn Header="Privilege" Binding="{Binding PrivilegeEscalation}" Width="75"/>
                                <DataGridTextColumn Header="Request" Binding="{Binding Summary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Web Bridge: " Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding WebBridgeConnected, StringFormat='Connected={0}'}" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="{Binding WebBridgeAuthorized, StringFormat='Authorized={0}'}" Foreground="{StaticResource Accent}" Margin="8,0,0,0"/>
                            <TextBlock Text=" &#x00B7; Web Pair/Approve tetap dilakukan di Chrome Bridge."
                                       Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Deny" Style="{StaticResource DangerButton}" Command="{Binding DenyCommand}" IsEnabled="{Binding SelectedApproval.CanResolveLocally}"/>
                            <Button Content="Approve" Style="{StaticResource SuccessButton}" Command="{Binding ApproveCommand}" IsEnabled="{Binding SelectedApproval.CanResolveLocally}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="&#x21C4;  Tunnel / MCP">
                <Grid Margin="20" Background="{StaticResource WindowBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tunnel / MCP Services" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Routing control and MCP service management."
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource AccentSoft}" CornerRadius="9" Padding="10,5" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding RouterStatus}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{StaticResource AccentSoft}" CornerRadius="9" Padding="10,5">
                                    <TextBlock Text="{Binding RouterToolCount, StringFormat=Tools: {0}}" Foreground="{StaticResource Accent}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding RouterServices}"
                              SelectedItem="{Binding SelectedRouterService}"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace}" Width="110"/>
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*"/>
                            <DataGridTextColumn Header="Agent Status" Binding="{Binding AgentStatus}" Width="110"/>
                            <DataGridTextColumn Header="MCP Status" Binding="{Binding McpStatus}" Width="105"/>
                            <DataGridTextColumn Header="Routing" Binding="{Binding Routing}" Width="90"/>
                            <DataGridTextColumn Header="Tools" Binding="{Binding Tools}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button Content="Enable Routing"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding EnableRoutingCommand}"/>
                        <Button Content="Disable Routing"
                                Command="{Binding DisableRoutingCommand}"
                                Margin="8,0,0,0"/>
                        <Button Content="Reconnect"
                                Command="{Binding ReconnectRouterCommand}"
                                Margin="8,0,0,0"/>
                        <Button Content="Test"
                                Command="{Binding TestRouterCommand}"
                                Margin="8,0,0,0"/>
                        <Button Content="Tools"
                                Command="{Binding RouterToolsCommand}"
                                Margin="8,0,0,0"/>
                        <Button Content="Reload List"
                                Command="{Binding ReloadRouterCommand}"
                                Margin="8,0,0,0"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="&#x002B;  Development">
                <Grid Margin="20" Background="{StaticResource WindowBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Add Development Agent" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Tambahkan MCP agent lokal ke Development Gateway. Port harus berada pada 18900&#x2013;18999."
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,3,0,12"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Name" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DevelopmentName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Namespace" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DevelopmentNamespace, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="MCP URL" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DevelopmentUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <Button Grid.Column="3"
                                        Content="+ Add Agent"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AddDevelopmentCommand}"
                                        VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="16,12">
                                <TextBlock Text="Development Agents" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Agent tambahan disimpan terpisah dari core production agents dan diroute melalui Zagent Tunnel."
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding DevelopmentAgents}"
                                      BorderThickness="0,1,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="160"/>
                                    <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace}" Width="130"/>
                                    <DataGridTextColumn Header="MCP URL" Binding="{Binding Url}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80"/>
                                    <DataGridTextColumn Header="Timeout" Binding="{Binding TimeoutSeconds}" Width="75"/>
                                    <DataGridTemplateColumn Header="Action" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Remove"
                                                        Style="{StaticResource DangerButton}"
                                                        Padding="9,4"
                                                        Command="{Binding DataContext.RemoveDevelopmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="&#x25A3;  Technical Logs">
                <Grid Margin="20" Background="{StaticResource WindowBackground}">
                    <DataGrid ItemsSource="{Binding TechnicalLogs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time UTC" Binding="{Binding TimestampUtc}" Width="180"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="75"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="130"/>
                            <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="180"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="&#x2699;  Settings">
                <TabControl Margin="14"
                            Background="{StaticResource WindowBackground}">
                    <TabItem Header="Connection &amp; Security">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Background="{StaticResource WindowBackground}">
                            <StackPanel Margin="20" MaxWidth="880" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorder}" Width="820">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42"
                                            Background="{StaticResource AccentSoft}"
                                            CornerRadius="10"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="&#x2194;"
                                                   Foreground="{StaticResource Accent}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Zagent Tunnel Connection"
                                                   FontSize="18"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="Control-plane Tunnel ID and API key"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Tunnel ID"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,20,0,5"/>
                                <TextBox x:Name="TunnelIdBox"
                                         Width="560"
                                         HorizontalAlignment="Left"
                                         Text="{Binding TunnelId, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="API Key"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,14,0,5"/>
                                <PasswordBox x:Name="TunnelApiKeyBox"
                                             Width="560"
                                             HorizontalAlignment="Left"/>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Stored key: " Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding TunnelApiKeyStatus}"
                                               Foreground="{StaticResource Accent}"
                                               FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Text="{Binding TunnelSettingsHint}"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save Tunnel Settings"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="SaveTunnelSettings_Click"/>
                                    <TextBlock Text="API key kosong = pertahankan key lama."
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Width="820" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Device Identity &amp; Session Binding" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Identitas perangkat permanen, exact-device routing, dan binding chat aktif. Secret identity tidak pernah ditampilkan."
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Device Alias" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="300" Text="{Binding DeviceAlias, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"/>
                                        <Button Content="Save Alias" Command="{Binding SaveDeviceAliasCommand}" Margin="8,0,0,0" Padding="12,5"/>
                                        <Button Content="Re-verify" Command="{Binding ReverifyDeviceIdentityCommand}" Margin="8,0,0,0" Padding="12,5"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="Device Name" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceName}" FontWeight="SemiBold" Margin="0,3"/>

                                    <TextBlock Grid.Row="2" Text="Device ID" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding DeviceId, Mode=OneWay}"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="#F8F7FC"
                                             Padding="8,5"/>

                                    <TextBlock Grid.Row="3" Text="Trust State" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{Binding DeviceTrustState}"
                                               Foreground="{StaticResource Success}"
                                               FontWeight="SemiBold"
                                               Margin="0,3"/>

                                    <TextBlock Grid.Row="4" Text="Fingerprint" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DeviceShortFingerprint}" Margin="0,3"/>

                                    <TextBlock Grid.Row="5" Text="Installation ID" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DeviceInstallationId}" Margin="0,3"/>

                                    <TextBlock Grid.Row="6" Text="Protection" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DeviceProtection}" Margin="0,3"/>

                                    <TextBlock Grid.Row="7" Text="Target Validation" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DeviceTargetValidationMode}" Margin="0,3"/>

                                    <TextBlock Grid.Row="8" Text="Session Bindings" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding DeviceSessionBindingSummary}" Margin="0,3"/>
                                </Grid>

                                <TextBlock Text="{Binding IdentityRegistrySummary}"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,12,0,6"/>
                                <TextBlock Text="Trusted / Known Devices"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,6"/>
                                <DataGrid ItemsSource="{Binding IdentityDevices}"
                                          SelectedItem="{Binding SelectedIdentityDevice, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          MaxHeight="180">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Alias" Binding="{Binding DeviceAlias}" Width="*"/>
                                        <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="2*"/>
                                        <DataGridTextColumn Header="Trust" Binding="{Binding TrustState}" Width="*"/>
                                        <DataGridCheckBoxColumn Header="Online" Binding="{Binding Online}" Width="70"/>
                                        <DataGridCheckBoxColumn Header="Route" Binding="{Binding RouteAvailable}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding IdentitySessionIdInput, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,5"
                                             Margin="0,0,8,0"
                                             ToolTip="Session ID"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding IdentityOperatorAliasInput, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,5"
                                             Margin="0,0,8,0"
                                             ToolTip="Operator alias"/>
                                    <Button Grid.Column="2"
                                            Content="Bind Session to Selected Device"
                                            Command="{Binding BindIdentitySessionCommand}"
                                            Padding="12,5"/>
                                </Grid>

                                <TextBlock Text="Active Session Bindings"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,6"/>
                                <DataGrid ItemsSource="{Binding IdentitySessionBindings}"
                                          SelectedItem="{Binding SelectedIdentitySessionBinding, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Margin="0,12,0,0"
                                          MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="2*"/>
                                        <DataGridTextColumn Header="Operator" Binding="{Binding OperatorAlias}" Width="*"/>
                                        <DataGridTextColumn Header="Target Device" Binding="{Binding TargetDeviceId}" Width="2*"/>
                                        <DataGridTextColumn Header="Rev" Binding="{Binding Revision}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Switch Selected Session to Selected Device"
                                            Command="{Binding SwitchIdentitySessionCommand}"
                                            Padding="12,5"/>
                                    <Button Content="Revoke Selected Session Binding"
                                            Command="{Binding RevokeIdentitySessionCommand}"
                                            Margin="8,0,0,0"
                                            Padding="12,5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Width="820" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Security" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Tunnel API key tidak disimpan plaintext. Credential file diproteksi Windows DPAPI CurrentUser dan tidak ditulis ke tunnel.json, log, atau command line."
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Integrations">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Background="{StaticResource WindowBackground}">
                            <StackPanel Margin="20">
                                <TextBlock Text="Integrations"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Detector dan action lokal aktif. Status di bawah berasal dari runtime Zagent saat ini."
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,6"/>
                                <TextBlock Text="{Binding IntegrationActionStatus}"
                                           Foreground="{StaticResource Accent}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>

                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Google Chrome"
                                                       FontSize="18"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="Extension + Native Bridge"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,2,0,12"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="155"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Extension" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ChromeExtensionStatus}" FontWeight="SemiBold" Margin="0,4" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="1" Text="Trusted Profile" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChromeBoundProfile}" FontWeight="SemiBold" Margin="0,4" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="2" Text="Connected" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WebBridgeConnectionStatus}" FontWeight="SemiBold" Margin="0,4" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="3" Text="Authorized" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WebBridgeAuthorizationStatus}" FontWeight="SemiBold" Margin="0,4" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="4" Text="Persistent Consent" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ChromeConsentStatus}" FontWeight="SemiBold" Margin="0,4" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="5" Text="Trusted Reconnect" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ChromeReconnectStatus}" FontWeight="SemiBold" Margin="0,4" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="6" Text="Native CDP" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ChromeNativeAttachedStatus}" FontWeight="SemiBold" Margin="0,4" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="7" Text="Approved Tabs" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ChromeApprovedTabsStatus}" FontWeight="SemiBold" Margin="0,4" TextWrapping="Wrap"/>
                                            </Grid>
                                            <TextBlock Text="Chrome profile for the next access request"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,14,0,4"/>
                                            <ComboBox ItemsSource="{Binding ChromeProfileOptions}"
                                                      SelectedItem="{Binding SelectedChromeProfile, Mode=TwoWay}"
                                                      Width="250" HorizontalAlignment="Left"
                                                      ToolTip="Choose a Chrome profile with the installed Zagent Bridge extension."/>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Content="Request Access"
                                                        Command="{Binding ChromeRequestAccessCommand}"
                                                        Padding="12,6"/>
                                                <Button Content="Disconnect"
                                                        Command="{Binding ChromeDisconnectCommand}"
                                                        Margin="8,0,0,0" Padding="12,6"/>
                                                <Button Content="Refresh"
                                                        Command="{Binding RefreshIntegrationsCommand}"
                                                        Margin="8,0,0,0" Padding="12,6"/>
                                            </WrapPanel>
                                            <TextBlock Text="One Chrome profile is trusted at a time. Request Access replaces the old profile automatically. Click Approve once in that profile's Chrome Bridge popup. Permission persists after Chrome restart until Disconnect."
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ArcMap 10.6.1"
                                                       FontSize="18"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="Add-In + ArcTools + Python Bridge"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,2,0,12"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="155"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="ArcMap Desktop" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ArcMapDesktopStatus}" FontWeight="SemiBold" Margin="0,4"/>

                                                <TextBlock Grid.Row="1" Text="Zagent Add-In" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ArcMapAddInStatus}" FontWeight="SemiBold" Margin="0,4"/>

                                                <TextBlock Grid.Row="2" Text="ArcTools" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ArcMapToolsStatus}" FontWeight="SemiBold" Margin="0,4"/>

                                                <TextBlock Grid.Row="3" Text="MCP Agent" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ArcMapMcpStatus}" FontWeight="SemiBold" Margin="0,4"/>

                                                <TextBlock Grid.Row="4" Text="Bridge" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ArcMapBridgeStatus}" FontWeight="SemiBold" Margin="0,4"/>

                                                <TextBlock Grid.Row="5" Text="CURRENT-MXD" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ArcMapCurrentMxdStatus}" FontWeight="SemiBold" Margin="0,4"/>
                                            </Grid>

                                            <WrapPanel Margin="0,16,0,0">
                                                <Button Content="Open Toolbox Setup"
                                                        Command="{Binding ArcMapOpenSetupCommand}"/>
                                                <Button Content="Repair Bridge"
                                                        Command="{Binding ArcMapRepairBridgeCommand}"/>
                                                <Button Content="Check"
                                                        Command="{Binding ArcMapCheckCommand}"/>
                                            </WrapPanel>
                                            <TextBlock Text="DEV: setup menyiapkan runtime locator dan membuka ArcMapAgent.pyt. Add-In final production belum dipaketkan, sehingga status Add-In tidak dipalsukan sebagai Installed."
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Text="Core connected: "
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Connected}"
                               Foreground="{StaticResource Success}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>