<Window x:Class="Zagent.Bundle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zagent Setup"
        Width="690"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020"
        Foreground="#F4F7FB">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Zagent"
                       FontSize="30"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Setup 0.9.0 - Windows x64"
                       Foreground="#94A3B8"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Base folder instalasi"
                   Margin="0,24,0,7"
                   Foreground="#CBD5E1"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InstallPathBox"
                     Height="36"
                     Padding="9,7"
                     Background="#111A2D"
                     Foreground="White"
                     BorderBrush="#334155"/>
            <Button Grid.Column="1"
                    x:Name="BrowseButton"
                    Content="Pilih..."
                    Margin="8,0,0,0"
                    Padding="16,6"
                    Click="BrowseButton_Click"/>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Jenis instalasi"
                       VerticalAlignment="Center"
                       Foreground="#CBD5E1"/>
            <ComboBox Grid.Column="1"
                      x:Name="PluginRoleBox"
                      Height="34"
                      SelectedIndex="0"
                      Padding="8,4"
                      Background="#111A2D"
                      Foreground="White"
                      BorderBrush="#334155">
                <ComboBoxItem Content="Zagent Master — Ikbal"
                              Tag="zagent-production"/>
                <ComboBoxItem Content="Zagent User — Harry"
                              Tag="tryplugin"/>
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="4"
                    Margin="0,20,0,0">
            <ProgressBar x:Name="Progress"
                         Height="15"
                         Minimum="0"
                         Maximum="100"/>
            <TextBlock x:Name="StatusText"
                       Text="Siap untuk instalasi."
                       Foreground="#94A3B8"
                       Margin="0,9,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="5"
                Margin="0,18,0,0"
                Padding="14"
                Background="#111A2D"
                BorderBrush="#25324A"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock TextWrapping="Wrap"
                       Foreground="#A9B7CC">
                Pilih Zagent Master (Ikbal, port 188xx) atau Zagent User (Harry, port 191xx). Instalasi baru memiliki folder dan data terpisah. Untuk upgrade instalasi lama, pilih folder lama secara langsung; konfigurasi dan workspace dipertahankan. Google Chrome tetap eksternal.
            </TextBlock>
        </Border>

        <Grid Grid.Row="6"
              Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ModeText"
                       VerticalAlignment="Center"
                       Foreground="#94A3B8"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Padding="16,7"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click"/>
                <Button x:Name="InstallButton"
                        Content="Install"
                        Padding="22,7"
                        Background="#2563EB"
                        Foreground="White"
                        Click="InstallButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>