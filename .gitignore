# Zagent v3 — source-only Git history for rollback.
# Keep application sources, project manifests, schemas, tests, docs, and build scripts.
# Never commit runtime state, device credentials, generated packages, or backups.

# Generated release/installers and external runtimes
/packaging/bundle/
/packaging/publish/
/packaging/staging/
/packaging/runtime/
