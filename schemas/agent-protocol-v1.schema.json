{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zagent.local/schemas/agent-protocol-v1.schema.json",
  "title": "Zagent Agent Protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "agent",
    "environment",
    "runtime",
    "transport",
    "lifecycle",
    "health",
    "capabilities"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "build": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "vendor": {
          "type": "string",
          "default": "Zohr System Agent"
        }
      }
    },
    "environment": {
      "enum": [
        "DEVELOPMENT",
        "STAGING",
        "PRODUCTION"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "entrypoint"
      ],
      "properties": {
        "language": {
          "enum": [
            "dotnet",
            "python",
            "node",
            "rust",
            "go",
            "native",
            "other"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "http-mcp",
            "named-pipe",
            "stdio",
            "internal"
          ]
        },
        "bind_host": {
          "type": [
            "string",
            "null"
          ]
        },
        "port": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_only": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "stop",
        "restart",
        "status",
        "diagnostics"
      ],
      "properties": {
        "start": {
          "type": "boolean"
        },
        "stop": {
          "type": "boolean"
        },
        "restart": {
          "type": "boolean"
        },
        "reload": {
          "type": "boolean",
          "default": false
        },
        "status": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "boolean"
        },
        "graceful_shutdown_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300,
          "default": 15
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe",
        "ready_states"
      ],
      "properties": {
        "probe": {
          "enum": [
            "mcp",
            "http",
            "named-pipe",
            "process",
            "custom"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "default": 10
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 5
        },
        "ready_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "READY",
              "DEGRADED",
              "OFFLINE",
              "FAILED"
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "access",
          "execution",
          "approval",
          "supports_cancel"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$"
          },
          "description": {
            "type": "string"
          },
          "access": {
            "enum": [
              "read",
              "write",
              "action",
              "admin"
            ]
          },
          "execution": {
            "enum": [
              "fast",
              "background",
              "exclusive"
            ]
          },
          "approval": {
            "enum": [
              "none",
              "policy",
              "user",
              "admin"
            ]
          },
          "supports_cancel": {
            "type": "boolean"
          },
          "supports_progress": {
            "type": "boolean",
            "default": false
          },
          "supports_resume": {
            "type": "boolean",
            "default": false
          },
          "resource_policy": {
            "enum": [
              "none",
              "shared",
              "read-lock",
              "write-lock",
              "exclusive"
            ],
            "default": "none"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "minimum_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "external": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}